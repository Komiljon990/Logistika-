# Seed: birinchi Super Admin
SEED_ADMIN_PHONE="+998901234567"
SEED_ADMIN_PASSWORD=""
# Demo hisoblar paroli (bo'sh bo'lsa demo kirish ko'rsatilmaydi). Demo ma'lumot: npm run db:demo
