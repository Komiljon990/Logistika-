# E-mail: bir martalik kod va taklifnomalar. SMTP bo'lmasa xatlar MAIL_OUTBOX fayliga yoziladi (sinov rejimi).
APP_URL="http://localhost:3000"
MAIL_OUTBOX=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# SMTP_HOST="off" — pochta sozlangan bo'lsa ham xatlar MAIL_OUTBOX fayliga yoziladi (sinov serveri uchun).
# Telegram: Super Admin botiga bildirishnoma (yangi ariza, kvitansiya). Token @BotFather'dan; chat id Super Admin sozlamalarida.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
# Super Admin boti (23.11.2026): ALOHIDA bot tokeni. Bo'lsa, ariza/kvitansiya xabarlari va admin tugmalari shu botda.
# scripts\admin-bot-sozlash.ps1 yozadi. Maxfiy.
SUPERADMIN_BOT_TOKEN=""
# Sayt: shu domen(lar)ga kelgan so'rovlar /site bo'limini ochadi; CRM_URL — saytdagi "Kirish" tugmasi manzili.
SITE_HOSTS="reyspro.uz,www.reyspro.uz"
CRM_URL=""
# Sinov serveri uchun: TELEGRAM_POLLING="off" — bot xabarlarni qabul qilmaydi (asosiy server bilan to'qnashmasligi uchun).
# TELEGRAM_API_URL — faqat sinovda soxta Telegram serveri uchun.
TELEGRAM_POLLING=""
TELEGRAM_API_URL=""
# Ovozli kiritish (Telegram bot, 21.11.2026): Cloudflare Workers AI (bepul kunlik limit). Ikkalasi bo'lmasa — o'chiq.
# Cloudflare → AI → Workers AI → «Use REST API»: Account ID va «Workers AI» huquqli token. Maxfiy.
