// 1-bosqich: tashkilotlar, foydalanuvchilar va audit.
// Keyingi bosqichlar jadvallari texnik shart tasdiqlangach qo'shiladi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ACCOUNTANT // Buxgalter: barcha tashkilotlar
  MANAGER // Menejer
  DIRECTOR // Rahbar
  DEPUTY // Ishonchli vakil
}

enum Status {
  ACTIVE
  BLOCKED
  ARCHIVED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  inn       String? // STIR
  phone     String?
  address   String?
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  vehicles  Vehicle[]
  drivers   Driver[]
  documents  Document[]
  files      StoredFile[]
  currencies OrgCurrency[]
  clients    Client[]
  trips      Trip[]
}

// ---------- Valyutalar va kurslar ----------

/// Markaziy bank kursi: 1 birlik valyuta necha so'm (nominal hisobga olingan). Kun bo'yicha, o'zgarmaydi.
model ExchangeRate {
  date DateTime @db.Date
  code String // ISO kod: USD, EUR, RUB, KZT ...
  rate Decimal  @db.Decimal(20, 8)
  name String? // valyuta nomi (MB ro'yxatidan)

  @@id([date, code])
  @@index([code, date])
}

/// Tashkilotning valyuta ro'yxati (13.11.2026: har tashkilotda o'zi, rahbar boshqaradi). UZS doim bor.
model OrgCurrency {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  code      String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@unique([orgId, code])
}

model User {
  id             String        @id @default(cuid())
  phone          String        @unique // +998901234567 ko'rinishida
  passwordHash   String
  fullName       String
  role           Role
  // SUPER_ADMIN va ACCOUNTANT uchun bo'sh, qolganlar uchun majburiy
  orgId          String?
  org            Organization? @relation(fields: [orgId], references: [id])
  status         Status        @default(ACTIVE)
  // Parol o'zgarsa yoki bloklansa eski sessiyalar bekor bo'ladi
  sessionVersion Int           @default(0)
  // Demo (reklama) hisobi: hamma narsani ko'radi, hech narsani saqlay olmaydi; faqat demo tashkilotda.
  isDemo         Boolean       @default(false)
  failedLogins   Int           @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([orgId])
}

model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  actorId  String?
  orgId    String?
  action   String // masalan: user.create, user.password_reset, org.block
  entity   String
  entityId String
  details  Json?

  @@index([orgId, at])
  @@index([entity, entityId])
}

// ---------- 2-bosqich: transport, haydovchilar, hujjatlar ----------

enum VehicleType {
  TRACTOR // tyagach
  TRAILER // prisept
  TRAIN // paravoz
  OTHER
}

enum Ownership {
  OWNED // balansda
  LEASED // ijarada
}

enum DriverCategory {
  EMPLOYEE // xodim-haydovchi
  OWNER_OPERATOR // o'z transportida ishlovchi
}

model Vehicle {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  plate          String // davlat raqami, katta harflarda, bo'shliqsiz
  model          String?
  type           VehicleType
  ownership      Ownership    @default(OWNED)
  leaseOwner     String?
  leaseStart     DateTime?    @db.Date
  leaseEnd       DateTime?    @db.Date
  // Standart juftlik: tyagachga prisept va haydovchi biriktiriladi
  pairTrailerId  String?
  pairTrailer    Vehicle?     @relation("Pair", fields: [pairTrailerId], references: [id])
  pairedTractors Vehicle[]    @relation("Pair")
  pairDriverId   String?
  pairDriver     Driver?      @relation(fields: [pairDriverId], references: [id])
  status         Status       @default(ACTIVE)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  documents Document[]
  tripsAsTractor Trip[] @relation("TripTractor")
  tripsAsTrailer Trip[] @relation("TripTrailer")

  @@index([orgId, status])
  @@index([orgId, plate])
}

model Driver {
  id        String         @id @default(cuid())
  orgId     String
  org       Organization   @relation(fields: [orgId], references: [id])
  fullName  String
  phone     String?
  category  DriverCategory
  status    Status         @default(ACTIVE)
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  documents      Document[]
  pairedVehicles Vehicle[]
  trips          Trip[]
  payments       Payment[]

  @@index([orgId, status])
}

enum DocType {
  // transport
  TECH_PASSPORT
  OWNERSHIP_DOC
  LEASE_CONTRACT
  LICENSE
  INSURANCE
  PERMIT // dopusheniya
  INSPECTION // texnik ko'rik
  TACHOGRAPH
  // haydovchi
  PASSPORT
  FOREIGN_PASSPORT
  DRIVING_LICENSE
  ADR
  CERTIFICATE
  VISA
  // tashkilot (litsenziya va boshqa — yuqoridagi LICENSE, OTHER)
  ORG_CERTIFICATE // guvohnoma
  CHARTER // ustav
  BANK_DETAILS // bank rekvizitlari
  // tashish
  WAYBILL // putyovka
  CMR // CMR / SMR
  DAZVOL
  TIR_CARNET // TIR
  OTHER
}

/// Hujjat = ma'lumot + ixtiyoriy fayl. Yangilansa eskisi ARCHIVED bo'ladi, yangisi prevId orqali bog'lanadi.
/// Egasi: transport (vehicleId), haydovchi (driverId) yoki ikkalasi bo'sh bo'lsa — tashkilotning o'zi.
model Document {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  vehicleId   String?
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id])
  driverId    String?
  driver      Driver?      @relation(fields: [driverId], references: [id])
  tripId      String?
  trip        Trip?        @relation(fields: [tripId], references: [id])
  type        DocType
  title       String? // "Boshqa" turidagi hujjat uchun foydalanuvchi bergan nom
  number      String?
  issuedAt    DateTime?    @db.Date
  expiresAt   DateTime?    @db.Date
  noExpiry    Boolean      @default(false) // muddatsiz (doimiy): masalan guvohnoma, doimiy litsenziya
  note        String?
  fileId      String?      @unique
  file        StoredFile?  @relation(fields: [fileId], references: [id])
  status      Status       @default(ACTIVE)
  prevId      String?      @unique
  prev        Document?    @relation("Versions", fields: [prevId], references: [id])
  next        Document?    @relation("Versions")
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId, status, expiresAt])
  @@index([vehicleId])
  @@index([driverId])
  @@index([tripId])
}

// ---------- Mijozlar va tashishlar ----------

/// Mijoz (yuk beruvchi). Har tashkilotning o'z bazasi.
model Client {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  name      String
  inn       String? // STIR
  phone     String?
  address   String?
  note      String?
  status    Status       @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  shipments Shipment[]
  payments  Payment[]

  @@index([orgId, status, name])
}

enum TripStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Tashish holatlari ketma-ketligi (haydovchi bot orqali yoki menejer uning o'rniga belgilaydi).
enum TripEventType {
  ACCEPTED // qabul qildi
  ARRIVED_LOADING // yuklash manziliga yetdi
  LOADED // yuklandi
  EXITED_UZ // O'zbekistondan chiqdi
  ARRIVED_UNLOADING // tushirish manziliga yetdi
  UNLOADED // yuk tushirildi — transport bo'shaydi
  ENTERED_UZ // O'zbekistonga kirdi
}

enum EventSource {
  DRIVER // Telegram bot orqali
  MANAGER // menejer haydovchi o'rniga
}

enum PaymentTerms {
  CONTRACT // shartnoma: faqat bank hisob raqamiga
  CASH // naqd kelishuv: naqd pul yoki karta raqamiga
}

model Trip {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  number      Int // tashkilot ichida tartib raqami: TSH-0001
  routeFrom   String
  routeTo     String
  tractorId   String
  tractor     Vehicle      @relation("TripTractor", fields: [tractorId], references: [id])
  trailerId   String?
  trailer     Vehicle?     @relation("TripTrailer", fields: [trailerId], references: [id])
  driverId    String
  driver      Driver       @relation(fields: [driverId], references: [id])
  loadDate    DateTime     @db.Date
  cargo       String?
  note        String?
  status      TripStatus   @default(ACTIVE)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  shipments Shipment[]
  events    TripEvent[]
  documents Document[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([tractorId, status])
}

model TripEvent {
  id        String        @id @default(cuid())
  tripId    String
  trip      Trip          @relation(fields: [tripId], references: [id])
  type      TripEventType
  at        DateTime // haqiqiy vaqt (menejer kechikib kiritsa ham o'sha paytdagi vaqt)
  source    EventSource
  userId    String? // menejer kiritgan bo'lsa
  note      String?
  createdAt DateTime      @default(now())

  @@unique([tripId, type])
}

/// Yuk qismi (SMR): har biri alohida mijoz, alohida narx va to'lov kelishuvi.
model Shipment {
  id                 String       @id @default(cuid())
  orgId              String
  tripId             String
  trip               Trip         @relation(fields: [tripId], references: [id])
  clientId           String
  client             Client       @relation(fields: [clientId], references: [id])
  contactName        String // mijoz tomondan mas'ul shaxs
  contactPhone       String
  cargo              String?
  smrNumber          String? // CMR raqami
  terms              PaymentTerms
  price              Decimal      @db.Decimal(18, 2)
  currency           String
  accountingPrice    Decimal?     @db.Decimal(18, 2) // buxgalteriya narxi: qoldiqqa aralashmaydi
  accountingCurrency String?
  status             Status       @default(ACTIVE)
  createdById        String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  charges     ShipmentCharge[]
  allocations PaymentAllocation[]

  @@index([orgId, clientId])
  @@index([tripId])
}

// ---------- Hisob-kitob: qo'shimcha xarajat, prostoy, to'lovlar ----------

enum ChargeKind {
  EXTRA // qo'shimcha xarajat (mijozga hisoblanadi)
  DEMURRAGE // prostoy = kunlar × kunlik summa
}

/// Mijozga hisoblanadigan qo'shimcha summa; yuk qismi valyutasida. Qoldiqni oshiradi.
model ShipmentCharge {
  id          String     @id @default(cuid())
  orgId       String
  shipmentId  String
  shipment    Shipment   @relation(fields: [shipmentId], references: [id])
  kind        ChargeKind
  description String?
  days        Int?
  dailyAmount Decimal?   @db.Decimal(18, 2)
  amount      Decimal    @db.Decimal(18, 2)
  date        DateTime   @db.Date
  status      Status     @default(ACTIVE) // ARCHIVED = bekor qilingan
  createdById String
  createdAt   DateTime   @default(now())

  @@index([shipmentId])
}

enum PaymentMethod {
  BANK // bank hisob raqamiga (shartnoma)
  CASH // naqd pul (naqd kelishuv)
  CARD // karta raqamiga (naqd kelishuv); kimning kartasi — izohda
}

enum CashHolder {
  OFFICE // ofis kassasi
  DRIVER // haydovchi oldi, kassaga keyin topshiradi
}

/// Mijozdan kelgan to'lov. Tashishlarga taqsimlanmagan qismi — avans.
model Payment {
  id           String         @id @default(cuid())
  orgId        String
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id])
  date         DateTime       @db.Date
  amount       Decimal        @db.Decimal(18, 2)
  currency     String
  method       PaymentMethod
  receivedBy   CashHolder?
  driverId     String?
  driver       Driver?        @relation(fields: [driverId], references: [id])
  handedOverAt DateTime? // haydovchi kassaga topshirgan vaqt
  note         String?
  status       Status         @default(ACTIVE) // ARCHIVED = bekor qilingan
  createdById  String
  createdAt    DateTime       @default(now())

  allocations PaymentAllocation[]

  @@index([orgId, clientId])
  @@index([orgId, receivedBy, handedOverAt])
}

/// To'lovning yuk qismiga taqsimlangan qismi. Valyutalar har xil bo'lishi mumkin:
/// rate = 1 yuk valyutasi necha to'lov valyutasi (MB kursi yoki qo'lda kelishilgan).
model PaymentAllocation {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id])
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  applied    Decimal  @db.Decimal(18, 2) // yuk valyutasida qarzdan yopilgan summa
  consumed   Decimal  @db.Decimal(18, 2) // to'lov valyutasida sarflangan summa
  rate       Decimal  @db.Decimal(20, 8)
  rateManual Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([shipmentId])
  @@index([paymentId])
}

/// Fayl hozircha bazada saqlanadi (sinov uchun eng oddiy). Keyin S3 turidagi saqlashga ko'chiriladi.
model StoredFile {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  name         String
  mime         String
  size         Int
  data         Bytes
  uploadedById String
  createdAt    DateTime     @default(now())

  document Document?
}
